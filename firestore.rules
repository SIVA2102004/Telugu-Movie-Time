rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper authentication checks
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public read for published movie config & screens; writes allowed for authenticated session admins
    match /movieConfig/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Theater multi-tenant collection
    match /theaters/{theaterId} {
      allow read: if true;
      allow create, update, delete: if true;

      match /halls/{hallId} {
        allow read: if true;
        allow write: if true;
      }
      
      match /coAdmins/{coId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Ticket bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // User account profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAuthenticated() || true;
    }

    // Realtime seat locks
    match /activeLocks/{lockId} {
      allow read, write: if true;
    }

    // Co-Admins collection (Strict validation)
    match /coAdmins/{coId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
